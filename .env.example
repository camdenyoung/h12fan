# Copy to .env. Start in demo mode; change to false to connect to your BMC.
H12FAN_DEMO=true
IPMI_HOST=192.168.1.100
IPMI_USER=fancontroller
IPMI_PASSWORD=
# Optional web UI password (any length). Leave blank for no login. Username: admin.
H12FAN_WEB_PASSWORD=
# Set a trusted LAN interface address to make the dashboard reachable remotely.
H12FAN_LISTEN_ADDRESS=127.0.0.1
# Host port for the web UI. Change this if another container uses port 8080.
H12FAN_WEB_PORT=8080
IPMI_PORT=623
# lanplus uses IPMI 2.0. Set lan to match ipmitool -H commands without an explicit -I.
IPMI_INTERFACE=lanplus
# Cipher applies only to lanplus.
IPMI_CIPHER=3
